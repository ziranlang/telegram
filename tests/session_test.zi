Session :: #import "session";
E :: #import "encoding";
Auth :: #import "auth";
Time :: #import "std/timer_linux";
c :: #system_library "libc";
ClockProbe :: (clock: s32, value: *Time.ClockValue) -> s32 #foreign c "clock_gettime";
#import "std/json_scan"
DialogChecks :: () -> s32 {
    failures: s32
    // Every dialog becomes a chat with a person's full name, its newest
    // message and mute state; the account's own chat is Saved Messages.
    Session.head=Session.tail;Session.account.user="{\"@type\":\"user\",\"id\":100}"
    dialogs:="{\"@type\":\"messages.dialogsSlice\",\"count\":4,\"dialogs\":[{\"@type\":\"dialog\",\"peer\":{\"@type\":\"peerUser\",\"user_id\":200},\"top_message\":77,\"read_inbox_max_id\":70,\"unread_count\":7,\"notify_settings\":{\"@type\":\"peerNotifySettings\",\"mute_until\":2147483647}},{\"@type\":\"dialog\",\"peer\":{\"@type\":\"peerChannel\",\"channel_id\":5},\"top_message\":9,\"read_inbox_max_id\":9,\"unread_count\":0,\"notify_settings\":{\"@type\":\"peerNotifySettings\"}},{\"@type\":\"dialog\",\"peer\":{\"@type\":\"peerUser\",\"user_id\":100},\"top_message\":3,\"read_inbox_max_id\":3,\"unread_count\":0,\"notify_settings\":{\"@type\":\"peerNotifySettings\"}},{\"@type\":\"dialog\",\"peer\":{\"@type\":\"peerUser\",\"user_id\":300},\"top_message\":4,\"read_inbox_max_id\":4,\"unread_count\":0,\"notify_settings\":{\"@type\":\"peerNotifySettings\"}}],\"messages\":[],\"chats\":[{\"@type\":\"channel\",\"id\":5,\"title\":\"News\",\"broadcast\":true}],\"users\":[{\"@type\":\"user\",\"id\":200,\"first_name\":\"Alice\",\"last_name\":\"Doe\"},{\"@type\":\"user\",\"id\":100,\"first_name\":\"Owner\"},{\"@type\":\"user\",\"id\":300,\"first_name\":\"Helper\",\"bot\":true}]}"
    if Session.Announce(dialogs,0)!=4 { failures+=1;print("FAIL every dialog is announced\n") }
    person:=Session.Receive(0.0);chat:=FieldAt(person,0,"chat");unused Session.Receive(0.0)
    if E.String(person,chat,"title")!="Alice Doe" || E.Number(person,chat,"last_message_id")!=77 || E.Raw(person,FieldAt(person,chat,"is_muted"))!="true" { failures+=1;print("FAIL private chat carries full name, newest message and mute state\n") }
    news:=Session.Receive(0.0);chat=FieldAt(news,0,"chat");unused Session.Receive(0.0)
    if E.String(news,chat,"title")!="News" || E.Raw(news,FieldAt(news,FieldAt(news,chat,"type"),"is_channel"))!="true" || E.Number(news,chat,"id")!=-1000000000005 || E.Raw(news,FieldAt(news,chat,"is_muted"))!="false" { failures+=1;print("FAIL broadcast channel is announced as a channel\n") }
    saved:=Session.Receive(0.0);unused Session.Receive(0.0)
    if E.String(saved,FieldAt(saved,0,"chat"),"title")!="Saved Messages" { failures+=1;print("FAIL own chat is Saved Messages\n") }
    helper:=Session.Receive(0.0);unused Session.Receive(0.0)
    if E.Raw(helper,FieldAt(helper,FieldAt(helper,FieldAt(helper,0,"chat"),"type"),"is_bot"))!="true" { failures+=1;print("FAIL bot chats are marked\n") }
    return failures
}
MediaChecks :: () -> s32 {
    failures: s32
    // The largest photo wins; progressive sizes report their final length.
    message:="{\"@type\":\"message\",\"media\":{\"@type\":\"messageMediaPhoto\",\"photo\":{\"@type\":\"photo\",\"id\":5,\"sizes\":[{\"@type\":\"photoStrippedSize\",\"type\":\"i\"},{\"@type\":\"photoSize\",\"type\":\"m\",\"w\":320,\"h\":240,\"size\":9000},{\"@type\":\"photoSizeProgressive\",\"type\":\"y\",\"w\":1280,\"h\":960,\"sizes\":[4000,30000,81234]},{\"@type\":\"photoSize\",\"type\":\"x\",\"w\":800,\"h\":600,\"size\":50000}]}}}"
    best:=Session.PhotoSize(message,FieldAt(message,FieldAt(message,0,"media"),"photo"))
    if E.String(best,0,"type")!="y" || E.Number(best,0,"size")!=81234 { failures+=1;print("FAIL largest photo size\n") }
    return failures
}
LoginWaitChecks :: () -> s32 {
    failures: s32
    Session.head=Session.tail; Session.account.state="password"
    cpu_before: Time.ClockValue; cpu_after: Time.ClockValue
    unused ClockProbe(2,*cpu_before)
    before:=Time.MonotonicMilliseconds(); empty:=Session.Receive(0.05)
    elapsed:=Time.MonotonicMilliseconds()-before
    unused ClockProbe(2,*cpu_after)
    cpu_ms:=(cpu_after.seconds-cpu_before.seconds)*1000+(cpu_after.nanoseconds-cpu_before.nanoseconds)/1000000
    if empty!="" || elapsed<45 || cpu_ms>10 { failures+=1;print("FAIL sign-in receive waits without spinning: wall % ms, CPU % ms\n",elapsed,cpu_ms) }
    Session.Push("queued login event");before=Time.MonotonicMilliseconds()
    queued:=Session.Receive(0.5);elapsed=Time.MonotonicMilliseconds()-before
    if queued!="queued login event" || elapsed>=400 { failures+=1;print("FAIL queued sign-in event is delivered immediately\n") }
    before=Time.MonotonicMilliseconds();unused Session.Receive(0.0);unused Session.Receive(-1.0)
    if Time.MonotonicMilliseconds()-before>=400 { failures+=1;print("FAIL nonblocking sign-in receive\n") }
    print("Telegram sign-in idle receive: wall % ms, CPU % ms\n",50,cpu_ms)
    Session.account.state="";return failures
}
Main :: () -> s32 {
    failures: s32 = LoginWaitChecks()
    Session.pts=10;Session.date=100
    Session.Update("{\"@type\":\"updateShortMessage\",\"id\":12,\"user_id\":66,\"message\":\"Hello 🙂\",\"pts\":11,\"pts_count\":1,\"date\":101}")
    first:=Session.Receive(0.0);message:=E.Raw(first,FieldAt(first,0,"message"))
    // Check the normalized object rather than any serializer whitespace.
    content:=FieldAt(message,0,"content")
    if E.Kind(first)!="updateNewMessage" || Session.pts!=11 || E.Number(message,0,"chat_id")!=66 || E.String(message,FieldAt(message,content,"text"),"text")!="Hello 🙂" { failures+=1;print("FAIL short-message delivery\n") }
    Session.Update("{\"@type\":\"updateShortMessage\",\"id\":12,\"user_id\":66,\"message\":\"Hello 🙂\",\"pts\":11,\"pts_count\":1,\"date\":101}")
    if Session.Receive(0.0)!="" { failures+=1;print("FAIL duplicate sequence suppressed\n") }
    Session.Update("{\"@type\":\"updateDeleteMessages\",\"messages\":[12],\"pts\":12,\"pts_count\":1}")
    deleted:=Session.Receive(0.0)
    if E.Kind(deleted)!="updateDeleteMessages" || E.Number(deleted,0,"chat_id")!=0 { failures+=1;print("FAIL account-wide deletion identity\n") }
    Session.peer_ids[0]=-1000000000099;Session.peer_hashes[0]=9007199254740993;Session.peer_count=1;Session.channel_pts[0]=4
    Session.Update("{\"@type\":\"updateDeleteChannelMessages\",\"channel_id\":99,\"messages\":[12],\"pts\":5,\"pts_count\":1}")
    deleted=Session.Receive(0.0)
    if E.Number(deleted,0,"chat_id")!=-1000000000099 || Session.channel_pts[0]!=5 || Session.pts!=12 { failures+=1;print("FAIL independent channel cursor\n") }
    Session.Update("{\"@type\":\"updateShortChatMessage\",\"id\":13,\"chat_id\":42,\"from_id\":66,\"message\":\"Missed event\",\"pts\":15,\"pts_count\":1,\"date\":103}")
    unused Session.Receive(0.0)
    if !Session.account.client.gap || Session.pts!=12 { failures+=1;print("FAIL missing sequence triggers recovery without skipping cursor\n") }
    Session.Checkpoint();snapshot:=Session.Snapshot();Session.pts=0;Session.peer_count=0;Session.RestoreUpdates(snapshot)
    if Session.pts!=12 || Session.channel_pts[0]!=5 || Session.peer_hashes[0]!=9007199254740993 { failures+=1;print("FAIL durable update cursors and exact peer hash\n") }
    failures+=DialogChecks()
    failures+=MediaChecks()
    print("Telegram update sessions: % failures\n",failures);return failures
}
