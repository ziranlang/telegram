Folders :: #import "folders";
TL :: #import "tl";
E :: #import "encoding";
#import "std/json_scan"
#import "std/text"
Check :: (ok: bool, label: string) -> s32 { if !ok { print("FAIL %\n",label); return 1 }; return 0 }
Main :: () -> s32 {
    failures: s32; bytes: [8192]u8
    failures+=Check(TL.Encode(Folders.Query,bytes[:])==4,"native dialog-filter RPC")
    reply:="{\"@type\":\"messages.dialogFilters\",\"filters\":[{\"@type\":\"dialogFilter\",\"id\":7,\"title\":{\"@type\":\"textWithEntities\",\"text\":\"Friends\",\"entities\":[]},\"emoticon\":\"🐾\",\"contacts\":true,\"exclude_muted\":true,\"exclude_read\":true,\"exclude_archived\":true,\"pinned_peers\":[{\"@type\":\"inputPeerSelf\"}],\"include_peers\":[{\"@type\":\"inputPeerChannel\",\"channel_id\":123,\"access_hash\":99},{\"@type\":\"inputPeerUser\",\"user_id\":9007199254740993,\"access_hash\":88}],\"exclude_peers\":[{\"@type\":\"inputPeerChat\",\"chat_id\":42}]},{\"@type\":\"dialogFilterDefault\"},{\"@type\":\"dialogFilterChatlist\",\"id\":9,\"title\":{\"@type\":\"textWithEntities\",\"text\":\"Work\",\"entities\":[]},\"pinned_peers\":[],\"include_peers\":[{\"@type\":\"inputPeerChat\",\"chat_id\":12}]}]}"
    encoded:=TL.Encode(reply,bytes[:])
    failures+=Check(encoded>0,"server folder definitions serialize through native TL")
    normalized:=Folders.Normalize(TL.Decode(bytes[:encoded]),5)
    rows:=FieldAt(normalized,0,"folders"); first:=ElementAt(normalized,rows,0)
    failures+=Check(E.Kind(normalized)=="chatFolders" && ArrayCount(normalized,rows)==3,"saved folders and default keep server order")
    failures+=Check(E.Number(normalized,first,"id")==7 && E.Number(normalized,ElementAt(normalized,rows,1),"id")==0,"default stays in its premium order")
    failures+=Check(E.String(normalized,first,"title")=="Friends" && E.String(normalized,first,"emoticon")=="🐾","server title and icon retained")
    folder:=E.Raw(normalized,first)
    failures+=Check(Folders.Position(folder,"pinned_peers",5)==0 && Folders.Position(folder,"include_peers",-1000000000123)==0,"self and channel peer IDs normalized")
    failures+=Check(Folders.Position(folder,"include_peers",9007199254740993)==1 && Folders.Position(folder,"exclude_peers",-42)==0,"peer IDs retain full signed integer precision")
    failures+=Check(FieldAt(folder,0,"access_hash")<0,"account access hashes are not exported")
    failures+=Check(Folders.Matches(folder,.{id=6,contact=true}),"contacts match dynamic folder")
    failures+=Check(!Folders.Matches(folder,.{id=6,contact=true,muted=true}) && !Folders.Matches(folder,.{id=6,contact=true,read=true}) && !Folders.Matches(folder,.{id=6,contact=true,archived=true}),"saved exclusions filter ordinary contacts")
    failures+=Check(Folders.Matches(folder,.{id=5,muted=true,read=true,archived=true}),"explicit pinned membership survives dynamic exclusions")
    failures+=Check(!Folders.Matches(folder,.{id=-42,group=true}),"explicit excluded membership wins")
    shared:=E.Raw(normalized,ElementAt(normalized,rows,2))
    failures+=Check(Folders.Flag(shared,0,"is_shared") && Folders.Matches(shared,.{id=-12,group=true}) && !Folders.Matches(shared,.{id=-13,group=true}),"shared folders use their explicit peers")
    fallback:=Folders.Normalize("{\"@type\":\"messages.dialogFilters\",\"filters\":[]}",5)
    failures+=Check(ArrayCount(fallback,FieldAt(fallback,0,"folders"))==1,"account without folders has only All chats")
    failures+=Check(!Folders.Matches("{\"is_default\":true}",.{id=3,archived=true}) && Folders.Matches("{\"is_default\":true}",.{id=3}),"All chats uses the main dialog list")
    failures+=Check(Folders.Normalize("{\"@type\":\"unexpected\"}",5)=="" && E.Kind(Folders.Normalize("{\"@type\":\"rpc_error\",\"error_code\":500}",5))=="rpc_error","failed reads cannot masquerade as an empty account")
    metadata:=Folders.DialogFields("{\"users\":[{\"id\":7,\"contact\":true}],\"dialog\":{\"unread_mark\":true,\"unread_mentions_count\":2,\"unread_reactions_count\":3}}",FieldAt("{\"users\":[{\"id\":7,\"contact\":true}],\"dialog\":{\"unread_mark\":true,\"unread_mentions_count\":2,\"unread_reactions_count\":3}}",0,"dialog"),7)
    wrapped: Vec(u8); BuilderPrint(*wrapped,"{%}",metadata[1:]); metadata=BuilderFinish(wrapped)
    failures+=Check(Folders.Flag(metadata,0,"is_contact") && Folders.Flag(metadata,0,"is_marked_as_unread") && E.Number(metadata,0,"unread_mention_count")==2 && E.Number(metadata,0,"unread_reaction_count")==3,"dialog membership metadata preserves contacts and unread signals")
    print("Telegram saved-folder tests: % failures\n",failures)
    return failures
}
