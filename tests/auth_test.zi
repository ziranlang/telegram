Auth :: #import "auth";
E :: #import "encoding";
Messages :: #import "messages";
TL :: #import "tl";
Main :: () -> s32 {
    failures: s32; entropy: [256]u8
    for i: 0..255 { entropy[i] = cast(u8)i }
    parameters := "{\"current_algo\":{\"@type\":\"passwordKdfAlgoSHA256SHA256PBKDF2HMACSHA512iter100000SHA256ModPow\",\"salt1\":\"c2FsdCBvbmU=\",\"salt2\":\"c2FsdCB0d28=\",\"p\":\"\",\"g\":3},\"srp_B\":\"\",\"srp_id\":9007199254740993}"
    proof := Auth.PasswordProof(parameters, "public test password", entropy[:])
    if E.String(proof,0,"A") != "" || E.String(proof,0,"M1") != "45OuXxTffmKJArIsbS80v590hvbH7ybAg34hlPoFzo4=" || E.Number(proof,0,"srp_id") != 9007199254740993 { print("FAIL independent SRP vector\n"); failures+=1 }
    if Auth.PasswordProof("{}", "secret", entropy[:]) != "" { print("FAIL reject unknown password algorithm\n"); failures+=1 }
    account: Auth.Account; account.client.connection.dc=2; account.client.connection.ready=true; account.client.connection.salt=-9007199254740993
    for i: 0..255 { account.client.connection.key[i]=cast(u8)i }
    snapshot := Auth.Snapshot(*account); restored: Auth.Account
    if !Auth.Restore(*restored,snapshot) || restored.client.connection.salt != -9007199254740993 || restored.client.connection.key[255] != cast(u8)255 { print("FAIL session round trip\n"); failures+=1 }
    if Auth.Restore(*restored,"{\"format\":1,\"dc\":2,\"test\":false,\"key\":\"bad\"}") { print("FAIL corrupt key rejected\n"); failures+=1 }
    bytes: [4096]u8
    init := "{\"@type\":\"invokeWithLayer\",\"layer\":227,\"query\":{\"@type\":\"initConnection\",\"api_id\":123,\"device_model\":\"Ziran\",\"system_version\":\"Linux\",\"app_version\":\"1.0\",\"system_lang_code\":\"en\",\"lang_pack\":\"\",\"lang_code\":\"en\",\"query\":{\"@type\":\"help.getConfig\"}}}"
    if TL.Encode(init,bytes[:])<=0 { print("FAIL generic initialization encoding\n"); failures+=1 }
    message := "{\"@type\":\"message\",\"id\":12,\"peer_id\":{\"@type\":\"peerChannel\",\"channel_id\":99},\"from_id\":{\"@type\":\"peerUser\",\"user_id\":55},\"date\":100,\"message\":\"Approve?\",\"reply_markup\":{\"@type\":\"replyInlineMarkup\",\"rows\":[{\"buttons\":[{\"@type\":\"keyboardButtonCallback\",\"text\":\"Approve\",\"data\":\"AP8=\"}]}]}}"
    normalized := Messages.Normalize(message,-1000000000099)
    if E.Number(normalized,0,"id")!=12 || E.Number(normalized,0,"chat_id")!=-1000000000099 { print("FAIL source identity\n"); failures+=1 }
    print("Telegram auth and normalization: % failures\n",failures); return failures
}
