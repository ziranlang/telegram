TL :: #import "tl";
E :: #import "encoding";
Check :: (ok: bool, label: string) -> s32 { if !ok { print("FAIL %\n",label); return 1 }; return 0 }
Main :: () -> s32 {
    bytes: [4096]u8; failures: s32
    sample: string="{\"@type\":\"inputPeerUser\",\"user_id\":1234567890123,\"access_hash\":-9007199254740993}"
    count:=TL.Encode(sample,bytes[:]); failures+=Check(count==20,"TL signed 64-bit peer encoding")
    decoded:=TL.Decode(bytes[:count]); failures+=Check(E.Number(decoded,0,"user_id")==1234567890123 && E.Number(decoded,0,"access_hash")==-9007199254740993,"TL exact integer round trip")
    sample="{\"@type\":\"messages.getHistory\",\"peer\":{\"@type\":\"inputPeerSelf\"},\"offset_id\":0,\"offset_date\":0,\"add_offset\":0,\"limit\":100,\"max_id\":0,\"min_id\":0,\"hash\":0}"
    count=TL.Encode(sample,bytes[:]); failures+=Check(count==40,"history RPC schema")
    failures+=Check(TL.Decode(bytes[:count-1])=="","truncated objects rejected")
    failures+=Check(TL.Encode("{\"@type\":\"doesNotExist\"}",bytes[:])<0,"unknown constructor rejected")
    value: [4]u8=.{0,255,17,128}; text:=E.Base64(value[:]); restored: [4]u8
    failures+=Check(text=="AP8RgA==" && E.Unbase64(text,restored[:])==4 && restored[1]==cast(u8)255,"binary base64 round trip")
    if failures==0 { print("TL protocol checks passed\n") }; return failures
}
