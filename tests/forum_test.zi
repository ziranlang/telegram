Session :: #import "session";
Messages :: #import "messages";
E :: #import "encoding";
TL :: #import "tl";
#import "std/json_scan"
#import "std/text"
Check :: (ok: bool, label: string) -> s32 { if !ok { print("FAIL %\n",label); return 1 }; return 0 }
Main :: () -> s32 {
    failures: s32
    general := Messages.Normalize("{\"@type\":\"message\",\"id\":44,\"reply_to\":{\"@type\":\"messageReplyHeader\",\"forum_topic\":true,\"reply_to_msg_id\":42}}",-1000000000999)
    failures+=Check(E.Number(general,0,"message_thread_id")==42 && FieldAt(general,0,"reply_to_message_id")<0,"topic root is a thread rather than a quoted reply")
    reply := Messages.Normalize("{\"@type\":\"message\",\"id\":45,\"reply_to\":{\"@type\":\"messageReplyHeader\",\"forum_topic\":true,\"reply_to_msg_id\":44,\"reply_to_top_id\":42}}",-1000000000999)
    failures+=Check(E.Number(reply,0,"message_thread_id")==42 && E.Number(reply,0,"reply_to_message_id")==44,"topic reply retains thread and quote independently")
    edited := Messages.Normalize("{\"@type\":\"messageService\",\"id\":46,\"action\":{\"@type\":\"messageActionTopicEdit\",\"title\":\"Design\"}}",-1000000000999)
    failures+=Check(E.Kind(E.Raw(edited,FieldAt(edited,0,"content")))=="messageForumTopicEdited","topic edits remain service events")
    topics := Session.ForumTopicsView("{\"@type\":\"messages.forumTopics\",\"count\":2,\"topics\":[{\"@type\":\"forumTopic\",\"id\":1},{\"@type\":\"forumTopic\",\"id\":42,\"title\":\"Design\",\"pinned\":true,\"unread_count\":3}]}",-1000000000999)
    rows := FieldAt(topics,0,"topics")
    failures+=Check(E.Kind(topics)=="forumTopics" && ArrayCount(topics,rows)==2 && E.String(topics,ElementAt(topics,rows,0),"title")=="General","forum rows preserve General and named topics")
    failures+=Check(E.Number(topics,ElementAt(topics,rows,1),"unread_count")==3 && MatchLiteral(topics,FieldAt(topics,ElementAt(topics,rows,1),"pinned"),"true"),"topic unread and pin metadata survives normalization")
    query:=Session.TextQuery("{\"random_id\":99,\"message_thread_id\":42,\"input_message_content\":{\"text\":{\"text\":\"fixture\"}}}","{\"@type\":\"inputPeerSelf\"}")
    target:=FieldAt(query,0,"reply_to")
    failures+=Check(E.Number(query,target,"top_msg_id")==42 && E.Number(query,target,"reply_to_msg_id")==42,"thread-only send targets the topic root")
    bytes: [4096]u8
    failures+=Check(TL.Encode(query,bytes[:])>0,"thread send serializes through actual TL without contacting Telegram")
    failures+=Check(Session.ReplyTo("{\"message_thread_id\":1}")=="","General has no synthetic reply target")
    print("Telegram forum tests: % failures\n",failures); return failures
}
