// MTProto 2.0 intermediate TCP transport and authenticated key exchange.
// All protocol and cryptography are Ziran; sockets and entropy are OS services.
Socket :: #import "std/socket_linux";
Random :: #import "std/random_linux";
Crypto :: #import "crypto/crypto";
Hash :: #import "crypto/sha256";
Sha1 :: #import "crypto/sha1";
Aes :: #import "crypto/aes";
Big :: #import "crypto/bigint";
TL :: #import "tl";
E :: #import "encoding";
Keys :: #import "keys";
#import "std/text"
#import "std/json_scan"
#import "std/byte_text_linux"
c :: #system_library "libc";
TimeRaw :: (value: *s64) -> s64 #foreign c "time";
Connection :: struct {
    socket: Socket.LinuxSocket; key: [256]u8; key_id: s64; salt: s64
    session: s64; sequence: s32; last_id: s64; clock: s64; dc: s32
    test: bool; ready: bool; error: string; received: [128]s64; receive_index: s32
}
Builder :: () -> Vec(u8) { result: Vec(u8);return result }
Now :: () -> s64 { return TimeRaw(null) }
Integer :: (bytes: []u8) -> s64 { buffer:=TL.Start(bytes); return TL.ReadLong(*buffer) }
NewId :: (connection: *Connection) -> s64 {
    random: [4]u8; if !Random.FillSecure(random[:]) { connection.error="Secure randomness unavailable"; return 0 }
    fraction: u64=cast(u64)random[0]|(cast(u64)random[1]<<cast(u64)8)|(cast(u64)random[2]<<cast(u64)16)|(cast(u64)random[3]<<cast(u64)24)
    value:=cast(s64)((cast(u64)(Now()+connection.clock)<<cast(u64)32)|(fraction&cast(u64)0xfffffffc))
    if value<=connection.last_id { value=connection.last_id+4 }; connection.last_id=value; return value
}
Address :: (dc: s32,test: bool) -> [4]u8 {
    if test { if dc==1 { return .{149,154,175,10} }; if dc==2 { return .{149,154,167,40} }; return .{149,154,175,117} }
    if dc==1 { return .{149,154,175,53} }; if dc==2 { return .{149,154,167,51} }; if dc==3 { return .{149,154,175,100} }; if dc==4 { return .{149,154,167,91} }; return .{91,108,56,130}
}
Open :: (connection: *Connection,dc: s32,test: bool) -> bool {
    if dc<1 || dc>5 || (test && dc>3) { connection.error="Invalid Telegram data center"; return false }
    if connection.socket.valid { unused Socket.SocketClose(*connection.socket) }
    connection.dc=dc;connection.test=test;connection.socket=Socket.OpenTCPv4(Address(dc,test),443,10000)
    if !connection.socket.valid { connection.error="Cannot connect to Telegram"; return false }
    header: [4]u8=.{238,238,238,238}
    if Socket.SocketSendAll(connection.socket,header[:],10000)!=4 { connection.error="Cannot initialize Telegram transport"; return false }
    random: [8]u8;if !Random.FillSecure(random[:]) { return false };connection.session=Integer(random[:]);connection.sequence=0;connection.receive_index=0;for i: 0..127 { connection.received[i]=0 };connection.last_id=0;return true
}
SendPacket :: (connection: *Connection,bytes: []u8) -> bool {
    if bytes.count<=0 || bytes.count>1048576 { return false };header: [4]u8;buffer:=TL.Start(header[:]);TL.Word(*buffer,cast(u32)bytes.count)
    if Socket.SocketSendAll(connection.socket,header[:],10000)!=4 || Socket.SocketSendAll(connection.socket,bytes,10000)!=bytes.count { connection.error="Telegram connection interrupted";return false };return true
}
Exact :: (connection: *Connection,bytes: []u8,timeout: s32) -> bool {
    at: s32;while at<bytes.count { count:=Socket.SocketReceive(connection.socket,bytes[at:],timeout);if count<=0 { return false };at+=cast(s32)count };return true
}
ReceivePacket :: (connection: *Connection,bytes: []u8,timeout: s32) -> s32 {
    header: [4]u8;if !Exact(connection,header[:],timeout) { return 0 };buffer:=TL.Start(header[:]);count:=cast(s32)TL.ReadWord(*buffer)
    if count<=0 || count>bytes.count || count%4!=0 { connection.error="Invalid Telegram transport frame";return -1 }
    if !Exact(connection,bytes[:count],10000) { connection.error="Incomplete Telegram transport frame";return -1 }
    if count==4 { connection.error="Telegram rejected the transport session";return -1 };return count
}
Unencrypted :: (connection: *Connection,json: string) -> string {
    packet: [4096]u8;buffer:=TL.Start(packet[:]);TL.Long(*buffer,0);TL.Long(*buffer,NewId(connection));TL.Word(*buffer,0)
    count:=TL.Encode(json,packet[20:]);if count<0 { connection.error="Invalid key-exchange request";return "" }
    length:=TL.Start(packet[16:20]);TL.Word(*length,cast(u32)count)
    if !SendPacket(connection,packet[:count+20]) { return "" };size:=ReceivePacket(connection,packet[:],10000)
    if size<20 { connection.error="Missing key-exchange response";return "" };buffer=TL.Start(packet[:size]);if TL.ReadLong(*buffer)!=0 { return "" };unused TL.ReadLong(*buffer);body:=cast(s32)TL.ReadWord(*buffer)
    if body!=size-20 { connection.error="Invalid key-exchange response length";return "" };return TL.Decode(packet[20:size])
}
AddMod :: (a: u64,b: u64,n: u64) -> u64 { if a>=n-b { return a-(n-b) };return a+b }
MultiplyMod :: (a: u64,b: u64,n: u64) -> u64 { x:=a%n;y:=b;result: u64;while y>cast(u64)0 { if (y&cast(u64)1)!=cast(u64)0 { result=AddMod(result,x,n) };x=AddMod(x,x,n);y>>=cast(u64)1 };return result }
Gcd :: (a: u64,b: u64) -> u64 { x:=a;y:=b;while y>cast(u64)0 { remainder:=x%y;x=y;y=remainder };return x }
Factor :: (n: u64) -> u64 {
    if n<cast(u64)15 || n>cast(u64)0x7fffffffffffffff { return 0 };if n%cast(u64)2==cast(u64)0 { return 2 }
    for seed: 1..32 {
        x: u64=2;y: u64=2;divisor: u64=1;iteration: s32
        while divisor==cast(u64)1 && iteration<200000 {
            x=AddMod(MultiplyMod(x,x,n),cast(u64)seed,n);y=AddMod(MultiplyMod(y,y,n),cast(u64)seed,n);y=AddMod(MultiplyMod(y,y,n),cast(u64)seed,n)
            difference:=ifx x>y then x-y else y-x;divisor=Gcd(difference,n);iteration+=1
        };if divisor>cast(u64)1 && divisor<n { return divisor }
    };return 0
}
Natural :: (value: u64) -> string { bytes: [8]u8;for i: 0..7 { bytes[7-i]=cast(u8)(value>>cast(u64)(i*8)) };at: s32;while at<7 && bytes[at]==cast(u8)0 { at+=1 };return E.Base64(bytes[at:]) }
RsaPad :: (data: []u8,test: bool,output: []u8) -> bool {
    if data.count>144 || output.count!=256 { return false };modulus_bytes: [256]u8;hex:=Keys.ProductionModulus;if test { hex=Keys.TestModulus };if !E.Unhex(hex,modulus_bytes[:]) { return false };modulus:=Big.Prepare(modulus_bytes[:]);exponent: [3]u8=.{1,0,1}
    padded: [192]u8;input: [224]u8;encrypted: [224]u8;key: [32]u8;zero_iv: [32]u8;hash: [32]u8;combined: [256]u8
    for attempt: 0..31 {
        if !Random.FillSecure(padded[:]) || !Random.FillSecure(key[:]) { return false };for i: 0..cast(s32)data.count-1 { padded[i]=data[i] }
        for i: 0..191 { input[i]=padded[191-i] };context: Hash.Sha256Context;Hash.Sha256Initialize(*context);Hash.Sha256Update(*context,*key[0],32);Hash.Sha256Update(*context,*padded[0],192);Hash.Sha256Finish(*context,*input[192])
        if !Aes.Ige(key[:],zero_iv[:],input[:],encrypted[:],false) { return false };Hash.Sha256(*encrypted[0],224,*hash[0])
        for i: 0..31 { combined[i]=key[i]^hash[i] };for i: 0..223 { combined[i+32]=encrypted[i] }
        candidate:=Big.FromBytes(combined[:]);if Big.Compare(*candidate,*modulus.value)<0 { return Big.Power(combined[:],exponent[:],*modulus,output) }
    };return false
}
Prime :: "";
ValidDh :: (prime: []u8,g: s32,public: []u8) -> bool {
    if prime.count!=256 || public.count!=256 || g<2 || g>7 || E.Hex(prime)!=Prime { return false }
    remainder: s32;for i: 0..255 { remainder=(remainder*256+cast(s32)prime[i])%(4*g) }
    if (g==2 && remainder%8!=7) || (g==3 && remainder%3!=2) || (g==5 && remainder%5!=1 && remainder%5!=4) || (g==6 && remainder%24!=19 && remainder%24!=23) || (g==7 && remainder%7!=3 && remainder%7!=5 && remainder%7!=6) { return false }
    // Enforce 2^(2048-64) < public < p-2^(2048-64), as specified.
    lower: Big.Integer;lower.limbs[124]=1;a:=Big.FromBytes(public);p:=Big.FromBytes(prime);upper:=Big.Subtract(*p,*lower)
    return Big.Compare(*a,*lower)>0 && Big.Compare(*a,*upper)<0
}
KeyExchange :: (connection: *Connection) -> bool {
    nonce: [16]u8;server_nonce: [16]u8;new_nonce: [32]u8
    if !Random.FillSecure(nonce[:]) || !Random.FillSecure(new_nonce[:]) { connection.error="Secure randomness unavailable";return false }
    out: Vec(u8);BuilderPrint(*out,"{\"@type\":\"req_pq_multi\",\"nonce\":%}",E.Quote(E.Hex(nonce[:])))
    reply:=Unencrypted(connection,BuilderFinish(out));if E.Kind(reply)!="resPQ" || E.String(reply,0,"nonce")!=E.Hex(nonce[:]) { connection.error="Invalid Telegram nonce";return false }
    if !E.Unhex(E.String(reply,0,"server_nonce"),server_nonce[:]) { return false };fingerprint:=Keys.ProductionFingerprint;if connection.test { fingerprint=Keys.TestFingerprint };found: bool;list:=FieldAt(reply,0,"server_public_key_fingerprints")
    for i: 0..ArrayCount(reply,list)-1 { if E.Integer(E.Raw(reply,ElementAt(reply,list,cast(s32)i)))==fingerprint { found=true } };if !found { connection.error="Unknown Telegram server key";return false }
    pq_bytes: [8]u8;count:=E.Unbase64(E.String(reply,0,"pq"),pq_bytes[:]);if count<=0 { return false };pq: u64;for i: 0..count-1 { pq=(pq<<cast(u64)8)|cast(u64)pq_bytes[i] };p:=Factor(pq);if p==cast(u64)0 { connection.error="Telegram proof of work failed";return false };q:=pq/p;if p>q { swap:=p;p=q;q=swap }
    out=Builder();dc:=connection.dc;if connection.test { dc+=10000 }
    BuilderPrint(*out,"{\"@type\":\"p_q_inner_data_dc\",\"pq\":%,\"p\":%,\"q\":%,\"nonce\":%,\"server_nonce\":%,\"new_nonce\":%,\"dc\":%}",E.Quote(E.Base64(pq_bytes[:count])),E.Quote(Natural(p)),E.Quote(Natural(q)),E.Quote(E.Hex(nonce[:])),E.Quote(E.Hex(server_nonce[:])),E.Quote(E.Hex(new_nonce[:])),dc)
    inner: [256]u8;encrypted: [256]u8;size:=TL.Encode(BuilderFinish(out),inner[:]);if size<0 || !RsaPad(inner[:size],connection.test,encrypted[:]) { connection.error="Cannot encrypt Telegram key exchange";return false }
    out=Builder();BuilderPrint(*out,"{\"@type\":\"req_DH_params\",\"nonce\":%,\"server_nonce\":%,\"p\":%,\"q\":%,\"public_key_fingerprint\":%,\"encrypted_data\":%}",E.Quote(E.Hex(nonce[:])),E.Quote(E.Hex(server_nonce[:])),E.Quote(Natural(p)),E.Quote(Natural(q)),fingerprint,E.Quote(E.Base64(encrypted[:])))
    reply=Unencrypted(connection,BuilderFinish(out));if E.Kind(reply)!="server_DH_params_ok" || E.String(reply,0,"nonce")!=E.Hex(nonce[:]) || E.String(reply,0,"server_nonce")!=E.Hex(server_nonce[:]) { connection.error="Telegram key-exchange response rejected";return false }
    temporary_key: [32]u8;temporary_iv: [32]u8;a: [20]u8;b: [20]u8;d: [20]u8;hash_input: [64]u8
    for i: 0..31 { hash_input[i]=new_nonce[i] };for i: 0..15 { hash_input[i+32]=server_nonce[i] };unused Sha1.Sha1(hash_input[:48],a[:])
    for i: 0..15 { hash_input[i]=server_nonce[i] };for i: 0..31 { hash_input[i+16]=new_nonce[i] };unused Sha1.Sha1(hash_input[:48],b[:])
    for i: 0..31 { hash_input[i]=new_nonce[i];hash_input[i+32]=new_nonce[i] };unused Sha1.Sha1(hash_input[:],d[:])
    for i: 0..19 { temporary_key[i]=a[i];temporary_iv[i+8]=d[i] };for i: 0..11 { temporary_key[i+20]=b[i] };for i: 0..7 { temporary_iv[i]=b[i+12] };for i: 0..3 { temporary_iv[i+28]=new_nonce[i] }
    cipher: [1024]u8;plain: [1024]u8;size=E.Unbase64(E.String(reply,0,"encrypted_answer"),cipher[:]);if size<32 || size%16!=0 || !Aes.Ige(temporary_key[:],temporary_iv[:],cipher[:size],plain[:size],true) { return false }
    reader:=TL.Start(plain[20:size]);body: Vec(u8);TL.DecodeType(*reader,"Object",*body,0);if !reader.valid { return false };unused Sha1.Sha1(plain[20:20+reader.at],a[:]);if !Crypto.Equal(a[:],plain[:20]) { connection.error="Telegram DH answer hash mismatch";return false };reply=BuilderFinish(body)
    if E.String(reply,0,"nonce")!=E.Hex(nonce[:]) || E.String(reply,0,"server_nonce")!=E.Hex(server_nonce[:]) { return false }
    prime: [256]u8;ga: [256]u8;gb: [256]u8;secret: [256]u8;g:=cast(s32)E.Number(reply,0,"g")
    if E.Unbase64(E.String(reply,0,"dh_prime"),prime[:])!=256 || E.Unbase64(E.String(reply,0,"g_a"),ga[:])!=256 || !ValidDh(prime[:],g,ga[:]) { connection.error="Invalid Telegram Diffie-Hellman parameters";return false }
    connection.clock=E.Number(reply,0,"server_time")-Now();modulus:=Big.Prepare(prime[:]);generator: [1]u8;generator[0]=cast(u8)g
    if !Random.FillSecure(secret[:]) || !Big.Power(generator[:],secret[:],*modulus,gb[:]) || !ValidDh(prime[:],g,gb[:]) || !Big.Power(ga[:],secret[:],*modulus,connection.key[:]) { return false };Crypto.Wipe(secret[:])
    out=Builder();BuilderPrint(*out,"{\"@type\":\"client_DH_inner_data\",\"nonce\":%,\"server_nonce\":%,\"retry_id\":0,\"g_b\":%}",E.Quote(E.Hex(nonce[:])),E.Quote(E.Hex(server_nonce[:])),E.Quote(E.Base64(gb[:])))
    size=TL.Encode(BuilderFinish(out),plain[20:]);if size<0 { return false };unused Sha1.Sha1(plain[20:size+20],plain[:20]);size+=20;padding: s32=(16-size%16)%16;if padding>0 && !Random.FillSecure(plain[size:size+padding]) { return false };size+=padding
    if !Aes.Ige(temporary_key[:],temporary_iv[:],plain[:size],cipher[:size],false) { return false }
    out=Builder();BuilderPrint(*out,"{\"@type\":\"set_client_DH_params\",\"nonce\":%,\"server_nonce\":%,\"encrypted_data\":%}",E.Quote(E.Hex(nonce[:])),E.Quote(E.Hex(server_nonce[:])),E.Quote(E.Base64(cipher[:size])))
    reply=Unencrypted(connection,BuilderFinish(out));unused Sha1.Sha1(connection.key[:],a[:]);for i: 0..31 { hash_input[i]=new_nonce[i] };hash_input[32]=1;for i: 0..7 { hash_input[i+33]=a[i] };unused Sha1.Sha1(hash_input[:41],b[:])
    if E.Kind(reply)!="dh_gen_ok" || E.String(reply,0,"nonce")!=E.Hex(nonce[:]) || E.String(reply,0,"server_nonce")!=E.Hex(server_nonce[:]) || E.String(reply,0,"new_nonce_hash1")!=E.Hex(b[4:20]) { Crypto.Wipe(connection.key[:]);connection.error="Telegram key confirmation failed";return false }
    connection.key_id=Integer(a[12:20]);salt: [8]u8;for i: 0..7 { salt[i]=new_nonce[i]^server_nonce[i] };connection.salt=Integer(salt[:]);connection.ready=true;Crypto.Wipe(new_nonce[:]);Crypto.Wipe(temporary_key[:]);Crypto.Wipe(temporary_iv[:]);return true
}
Derive :: (connection: *Connection,msg_key: []u8,incoming: bool,key: []u8,iv: []u8) {
    x: s32=0;if incoming { x=8 };input: [52]u8;a: [32]u8;b: [32]u8
    for i: 0..15 { input[i]=msg_key[i] };for i: 0..35 { input[i+16]=connection.key[x+i] };Hash.Sha256(*input[0],52,*a[0])
    for i: 0..35 { input[i]=connection.key[x+i+40] };for i: 0..15 { input[i+36]=msg_key[i] };Hash.Sha256(*input[0],52,*b[0])
    for i: 0..7 { key[i]=a[i];key[i+24]=a[i+24];iv[i]=b[i];iv[i+24]=b[i+24] };for i: 0..15 { key[i+8]=b[i+8];iv[i+8]=a[i+8] }
}
Encrypt :: (connection: *Connection,body: []u8,content: bool,output: []u8) -> s32 {
    if !connection.ready || body.count%4!=0 || body.count>1000000 || output.count<body.count+1088 { return -1 }
    plain: [1048576]u8;buffer:=TL.Start(plain[:]);TL.Long(*buffer,connection.salt);TL.Long(*buffer,connection.session);TL.Long(*buffer,NewId(connection));sequence:=connection.sequence*2;if content { sequence+=1;connection.sequence+=1 };TL.Word(*buffer,cast(u32)sequence);TL.Word(*buffer,cast(u32)body.count)
    for i: 0..cast(s32)body.count-1 { plain[32+i]=body[i] };size:=32+cast(s32)body.count;padding: s32=12;while (size+padding)%16!=0 { padding+=1 };if !Random.FillSecure(plain[size:size+padding]) { return -1 };size+=padding
    hash: [32]u8;context: Hash.Sha256Context;Hash.Sha256Initialize(*context);Hash.Sha256Update(*context,*connection.key[88],32);Hash.Sha256Update(*context,*plain[0],size);Hash.Sha256Finish(*context,*hash[0])
    key: [32]u8;iv: [32]u8;Derive(connection,hash[8:24],false,key[:],iv[:]);header:=TL.Start(output);TL.Long(*header,connection.key_id);for i: 0..15 { output[i+8]=hash[i+8] }
    if !Aes.Ige(key[:],iv[:],plain[:size],output[24:24+size],false) { return -1 };return size+24
}
Decrypt :: (connection: *Connection,input: []u8,output: []u8) -> s32 {
    if !connection.ready || input.count<72 || (input.count-24)%16!=0 || output.count<input.count-24 { return -1 };header:=TL.Start(input);if TL.ReadLong(*header)!=connection.key_id { return -1 }
    key: [32]u8;iv: [32]u8;Derive(connection,input[8:24],true,key[:],iv[:]);size:=cast(s32)input.count-24;if !Aes.Ige(key[:],iv[:],input[24:],output[:size],true) { return -1 }
    context: Hash.Sha256Context;hash: [32]u8;Hash.Sha256Initialize(*context);Hash.Sha256Update(*context,*connection.key[96],32);Hash.Sha256Update(*context,*output[0],size);Hash.Sha256Finish(*context,*hash[0]);if !Crypto.Equal(hash[8:24],input[8:24]) { return -1 }
    buffer:=TL.Start(output[:size]);salt:=TL.ReadLong(*buffer);session:=TL.ReadLong(*buffer);id:=TL.ReadLong(*buffer);sequence:=TL.ReadWord(*buffer);length:=cast(s32)TL.ReadWord(*buffer);padding:=size-32-length;stamp:=cast(s64)(cast(u64)id>>cast(u64)32)
    if session!=connection.session || length<0 || length%4!=0 || padding<12 || padding>1024 || (id&3)==0 || (id&3)==2 || stamp<Now()+connection.clock-300 || stamp>Now()+connection.clock+30 { return -1 }
    // Salts can change in a bad_server_salt notification. Its authenticated
    // body is handled by the RPC engine before adopting the replacement.
    unused salt;unused sequence
    for i: 0..127 { if connection.received[i]==id { return -2 } };connection.received[connection.receive_index]=id;connection.receive_index=(connection.receive_index+1)%128;return length
}
