// Normalize Telegram API messages without losing callback bytes or peer IDs.
E :: #import "encoding";
#import "std/json_scan"
#import "std/text"
ChatId :: (peer: string) -> s64 {
    kind := E.Kind(peer)
    if kind == "peerUser" { return E.Number(peer, 0, "user_id") }
    if kind == "peerChat" { return -E.Number(peer, 0, "chat_id") }
    if kind == "peerChannel" { return -1000000000000 - E.Number(peer, 0, "channel_id") }; return 0
}
Peer :: (chat: s64) -> string {
    out: Vec(u8)
    if chat > 0 { BuilderPrint(*out, "{\"@type\":\"peerUser\",\"user_id\":%}", chat) }
    else if chat <= -1000000000000 { BuilderPrint(*out, "{\"@type\":\"peerChannel\",\"channel_id\":%}", -1000000000000 - chat) }
    else { BuilderPrint(*out, "{\"@type\":\"peerChat\",\"chat_id\":%}", -chat) }; return BuilderFinish(out)
}
Normalize :: (message: string, chat: s64, self: s64 = 0) -> string {
    peer := E.Raw(message, FieldAt(message, 0, "from_id")); sender := ChatId(peer); outgoing := E.Raw(message, FieldAt(message, 0, "out")) == "true"
    if sender==0 { sender=chat;if outgoing && self>0 { sender=self } }
    out: Vec(u8); BuilderPrint(*out, "{\"@type\":\"message\",\"id\":%,\"chat_id\":%,\"date\":%,\"is_outgoing\":%,\"sender_id\":{\"@type\":\"%\",\"%\":%},\"content\":", E.Number(message, 0, "id"), chat, E.Number(message, 0, "date"), ifx outgoing then "true" else "false", ifx sender > 0 then "messageSenderUser" else "messageSenderChat", ifx sender > 0 then "user_id" else "chat_id", sender)
    kind := E.Kind(message); text := E.String(message, 0, "message")
    if kind == "messageService" {
        action:=FieldAt(message,0,"action");type:=E.String(message,action,"@type");content:="messageService"
        if type=="messageActionChatEditTitle" { content="messageChatChangeTitle" }
        if type=="messageActionChatEditPhoto" || type=="messageActionChatDeletePhoto" { content="messageChatChangePhoto" }
        if type=="messageActionChatCreate" { content="messageBasicGroupChatCreate" }
        if type=="messageActionChannelCreate" { content="messageSupergroupChatCreate" }
        if type=="messageActionChatAddUser" { content="messageChatAddMembers" }
        if type=="messageActionChatDeleteUser" { content="messageChatDeleteMember" }
        if type=="messageActionChatJoinedByLink" { content="messageChatJoinByLink" }
        if type=="messageActionChatJoinedByRequest" { content="messageChatJoinByRequest" }
        if type=="messageActionPinMessage" { content="messagePinMessage" }
        BuilderPrint(*out,"{\"@type\":%,\"title\":%}",E.Quote(content),E.Quote(E.String(message,action,"title")))
    }
    else {
        media := FieldAt(message, 0, "media"); media_kind := E.String(message, media, "@type")
        if media_kind == "messageMediaPhoto" { BuilderPrint(*out, "{\"@type\":\"messagePhoto\",\"caption\":{\"text\":%}}", E.Quote(text)) }
        else if media_kind == "messageMediaDocument" {
            document := FieldAt(message, media, "document"); attributes := FieldAt(message, document, "attributes"); name := "Attachment"; content := "messageDocument";title:="";emoji:=""
            for i: 0..ArrayCount(message, attributes) - 1 {
                at := ElementAt(message, attributes, i); attribute := E.String(message, at, "@type")
                if attribute == "documentAttributeFilename" { name = E.String(message, at, "file_name") }
                if attribute == "documentAttributeVideo" { content = "messageVideo" }
                if attribute == "documentAttributeAnimated" { content = "messageAnimation" }
                if attribute == "documentAttributeAudio" { content = "messageAudio";title=E.String(message,at,"title"); if E.Raw(message, FieldAt(message, at, "voice")) == "true" { content = "messageVoiceNote" } }
                if attribute == "documentAttributeSticker" { content = "messageSticker";emoji=E.String(message,at,"alt") }
            }
            if title=="" { title=name }
            BuilderPrint(*out, "{\"@type\":%,\"document\":{\"file_name\":%},\"audio\":{\"title\":%},\"sticker\":{\"emoji\":%},\"caption\":{\"text\":%}}", E.Quote(content), E.Quote(name),E.Quote(title),E.Quote(emoji), E.Quote(text))
        }
        else if media_kind=="messageMediaGeo" || media_kind=="messageMediaGeoLive" || media_kind=="messageMediaVenue" { BuilderPrint(*out,"{\"@type\":\"messageLocation\",\"caption\":{\"text\":%}}",E.Quote(text)) }
        else if media_kind=="messageMediaContact" { BuilderPrint(*out,"{\"@type\":\"messageContact\",\"caption\":{\"text\":%}}",E.Quote(text)) }
        else if media_kind=="messageMediaPoll" { BuilderPrint(*out,"{\"@type\":\"messagePoll\",\"poll\":{\"question\":{\"text\":%}}}",E.Quote(E.String(message,FieldAt(message,FieldAt(message,media,"poll"),"question"),"text"))) }
        else { BuilderPrint(*out, "{\"@type\":\"messageText\",\"text\":{\"@type\":\"formattedText\",\"text\":%}}", E.Quote(text)) }
    }
    // Replies name the message they answer; forwards name their origin.
    reply := FieldAt(message, 0, "reply_to")
    if E.String(message, reply, "@type") == "messageReplyHeader" && E.Number(message, reply, "reply_to_msg_id") > 0 { BuilderPrint(*out, ",\"reply_to_message_id\":%", E.Number(message, reply, "reply_to_msg_id")) }
    forward := FieldAt(message, 0, "fwd_from")
    if E.String(message, forward, "@type") == "messageFwdHeader" { BuilderPrint(*out, ",\"forward_info\":{\"from_id\":%,\"from_name\":%}", ChatId(E.Raw(message, FieldAt(message, forward, "from_id"))), E.Quote(E.String(message, forward, "from_name"))) }
    markup := FieldAt(message, 0, "reply_markup")
    if E.String(message, markup, "@type") == "replyInlineMarkup" {
        BuilderPrint(*out, ",\"reply_markup\":{\"@type\":\"replyMarkupInlineKeyboard\",\"rows\":["); rows := FieldAt(message, markup, "rows"); comma := ""
        for i: 0..ArrayCount(message, rows) - 1 {
            row := ElementAt(message, rows, i); buttons := FieldAt(message, row, "buttons"); cell_comma := ""; BuilderPrint(*out, "%[", comma)
            for j: 0..ArrayCount(message, buttons) - 1 {
                at := ElementAt(message, buttons, j); if E.String(message, at, "@type") != "keyboardButtonCallback" { continue }
                BuilderPrint(*out, "%{\"text\":%,\"type\":{\"@type\":\"inlineKeyboardButtonTypeCallback\",\"data\":%}}", cell_comma, E.Quote(E.String(message, at, "text")), E.Quote(E.String(message, at, "data"))); cell_comma = ","
            }; BuilderPrint(*out, "]"); comma = ","
        }; BuilderPrint(*out, "]}")
    }
    reactions := FieldAt(message, 0, "reactions"); results := FieldAt(message, reactions, "results"); BuilderPrint(*out, ",\"interaction_info\":{\"reactions\":{\"reactions\":["); comma := ""
    for i: 0..ArrayCount(message, results) - 1 {
        at := ElementAt(message, results, i); reaction := FieldAt(message, at, "reaction")
        if E.String(message, reaction, "@type") != "reactionEmoji" { continue }
        BuilderPrint(*out, "%{\"type\":{\"@type\":\"reactionTypeEmoji\",\"emoji\":%},\"total_count\":%,\"is_chosen\":%}", comma, E.Quote(E.String(message, reaction, "emoticon")), E.Number(message, at, "count"), ifx FieldAt(message, at, "chosen_order") >= 0 then "true" else "false"); comma = ","
    }; BuilderPrint(*out, "]}}}"); return BuilderFinish(out)
}
